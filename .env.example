# SamajhCare Environment Configuration Example
# Copy this file to .env if configuring local server variables.
# NEVER commit your actual API key to version control.

# Google Gemini API Key (Required for Live Gemini API mode)
# Generate a key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Port for optional lightweight server proxy (Default: 3000)
PORT=3000

# National Medical Emergency Contact in India
EMERGENCY_NUMBER=112
